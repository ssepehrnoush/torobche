# Torobche's WhatsApp gateway (deploy/wa-gateway in the torob-bazargard-map repo). API only, behind X-Api-Key.
# Exact server_name wins over the *.lemonai.ir desk wildcard, so desk and the client panels are untouched.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name wa.lemonai.ir;
    ssl_certificate     /etc/letsencrypt/live/lemonai.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lemonai.ir/privkey.pem;
    add_header X-Robots-Tag "noindex" always;
    client_max_body_size 32k;
    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }
}
